HOST=127.0.0.1
PORT=3000
# Relative paths are resolved from the directory where npm is run.
DB_PATH=./data/employees.sqlite
APP_ORIGIN=http://127.0.0.1:3000
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('base64')"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
# Use a unique password with 15-128 characters. Remove this after npm run admin:create.
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
